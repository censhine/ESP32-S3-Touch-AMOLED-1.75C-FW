+
+# Generate an explicit first-install image. Ordinary firmware updates do not
+# write this partition, so recordings and imported media are not replaced.
+idf_build_get_property(python PYTHON)
+set(MEDIA_SOURCE_DIR "${CMAKE_BINARY_DIR}/initial_media")
+execute_process(
+    COMMAND "${python}" "${CMAKE_CURRENT_LIST_DIR}/../tools/prepare_internal_media.py"
+        "${MEDIA_SOURCE_DIR}"
+    RESULT_VARIABLE MEDIA_PREPARE_RESULT
+)
+if(NOT MEDIA_PREPARE_RESULT EQUAL 0)
+    message(FATAL_ERROR "Could not prepare 1.75C initial media")
+endif()
+add_custom_target(initial_media_image ALL
+    COMMAND "${CMAKE_COMMAND}" -E rm -f "${CMAKE_BINARY_DIR}/media.bin"
+    COMMAND "${python}" "${CMAKE_CURRENT_LIST_DIR}/../tools/pack_media.py"
+        "${MEDIA_SOURCE_DIR}" "${CMAKE_BINARY_DIR}/media.bin"
+    BYPRODUCTS "${CMAKE_BINARY_DIR}/media.bin"
+    COMMENT "Packing 1.75C initial media (not part of normal firmware flash)"
+    VERBATIM
+)
